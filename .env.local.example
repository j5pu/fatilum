# Email Configuration - Configure with your email service
# Examples:
# - Sendgrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=<your-sendgrid-key>
# - Mailgun: host=smtp.mailgun.org, port=587, user=postmaster@<your-domain>, pass=<your-password>
# - AWS SES: host=email-smtp.<region>.amazonaws.com, port=587, user=<your-user>, pass=<your-password>
# - Your own SMTP: configure accordingly

SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-icloud-email@icloud.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-icloud-email@icloud.com
CONTACT_EMAIL=jose@mnopi.com
